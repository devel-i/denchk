<Window x:Class="HrPractice.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Отдел кадров — вход" Width="900" Height="620" MinWidth="700" MinHeight="500">
  <Grid Margin="16">
    <StackPanel x:Name="LoginPanel" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Отдел кадров" FontSize="24" Margin="0,0,0,20"/>
      <TextBlock Text="Логин"/>
      <TextBox x:Name="LoginBox" Margin="0,5,0,10"/>
      <Button Content="Войти" Click="Login_Click" Padding="8"/>
      <TextBlock Text="Примеры: isivanov (администратор), papetrov (пользователь)" TextWrapping="Wrap" Margin="0,15,0,0"/>
    </StackPanel>
    <DockPanel x:Name="WorkPanel" Visibility="Collapsed">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
        <TextBlock x:Name="UserNameText" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Content="Назад / выход" Click="Logout_Click"/>
      </StackPanel>
      <TabControl x:Name="Tabs">
        <TabItem Header="Сотрудники">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
              <TextBox x:Name="SearchBox" Width="150" Margin="6,0,15,0" TextChanged="Filter_Changed"/>
              <TextBlock Text="Подразделение:" VerticalAlignment="Center"/>
              <ComboBox x:Name="FilterBox" Width="170" Margin="6,0,15,0" SelectionChanged="Filter_Changed" DisplayMemberPath="Name"/>
              <TextBlock Text="Оклад:" VerticalAlignment="Center"/>
              <ComboBox x:Name="SortBox" Width="150" Margin="6,0,0,0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
              </ComboBox>
            </StackPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
            <DataGrid x:Name="EmployeeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="EmployeeGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="*"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding Department.Name}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position.Name}" Width="*"/>
                <DataGridTextColumn Header="Оклад" Binding="{Binding Position.Salary}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="EditTab" Header="Редактирование">
          <ScrollViewer><StackPanel Margin="8">
            <TextBlock Text="Подразделения" FontWeight="Bold"/>
            <DataGrid x:Name="DepartmentGrid" Height="100" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="DepartmentGrid_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
              <TextBox x:Name="DepartmentName" Width="170" ToolTip="Название"/>
              <TextBox x:Name="DepartmentLocation" Width="170" Margin="5,0" ToolTip="Расположение"/>
              <Button Content="Добавить" Click="AddDepartment_Click"/><Button Content="Изменить" Click="EditDepartment_Click" Margin="5,0"/><Button Content="Удалить" Click="DeleteDepartment_Click"/>
            </StackPanel>
            <TextBlock Text="Должности" FontWeight="Bold"/>
            <DataGrid x:Name="PositionGrid" Height="100" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="PositionGrid_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
              <TextBox x:Name="PositionName" Width="170" ToolTip="Название"/>
              <TextBox x:Name="PositionSalary" Width="100" Margin="5,0" ToolTip="Оклад, руб."/>
              <Button Content="Добавить" Click="AddPosition_Click"/><Button Content="Изменить" Click="EditPosition_Click" Margin="5,0"/><Button Content="Удалить" Click="DeletePosition_Click"/>
            </StackPanel>
            <TextBlock Text="Сотрудник (выбирается на первой вкладке)" FontWeight="Bold"/>
            <WrapPanel Margin="0,5,0,6">
              <TextBox x:Name="LastNameBox" Width="120" ToolTip="Фамилия"/><TextBox x:Name="FirstNameBox" Width="120" Margin="5,0" ToolTip="Имя"/>
              <TextBox x:Name="MiddleNameBox" Width="120" ToolTip="Отчество"/><ComboBox x:Name="DepartmentChoice" Width="150" Margin="5,0" DisplayMemberPath="Name" ToolTip="Подразделение"/>
              <ComboBox x:Name="PositionChoice" Width="150" DisplayMemberPath="Name" ToolTip="Должность"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal"><Button Content="Добавить" Click="AddEmployee_Click"/><Button Content="Изменить" Click="EditEmployee_Click" Margin="5,0"/><Button Content="Удалить" Click="DeleteEmployee_Click"/></StackPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
